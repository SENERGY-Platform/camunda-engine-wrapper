<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
    <bpmn:process id="test_message_start_long" isExecutable="true">
        <bpmn:startEvent id="StartEvent_1">
            <bpmn:outgoing>Flow_none_start</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:startEvent id="MessageStartEvent_1">
            <bpmn:outgoing>Flow_message_start</bpmn:outgoing>
            <bpmn:messageEventDefinition messageRef="Message_disable_test"/>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="Flow_none_start" sourceRef="StartEvent_1" targetRef="Wait_1"/>
        <bpmn:sequenceFlow id="Flow_message_start" sourceRef="MessageStartEvent_1" targetRef="Wait_1"/>
        <bpmn:intermediateCatchEvent id="Wait_1" name="one hour">
            <bpmn:incoming>Flow_none_start</bpmn:incoming>
            <bpmn:incoming>Flow_message_start</bpmn:incoming>
            <bpmn:outgoing>Flow_end</bpmn:outgoing>
            <bpmn:timerEventDefinition>
                <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
            </bpmn:timerEventDefinition>
        </bpmn:intermediateCatchEvent>
        <bpmn:sequenceFlow id="Flow_end" sourceRef="Wait_1" targetRef="EndEvent_1"/>
        <bpmn:endEvent id="EndEvent_1">
            <bpmn:incoming>Flow_end</bpmn:incoming>
        </bpmn:endEvent>
    </bpmn:process>
    <bpmn:message id="Message_disable_test" name="disable_test_message"/>
    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
        <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="test_message_start_long">
            <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
                <dc:Bounds x="173" y="102" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="MessageStartEvent_1_di" bpmnElement="MessageStartEvent_1">
                <dc:Bounds x="173" y="202" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="Flow_none_start_di" bpmnElement="Flow_none_start">
                <di:waypoint x="209" y="120"/>
                <di:waypoint x="262" y="120"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_message_start_di" bpmnElement="Flow_message_start">
                <di:waypoint x="209" y="220"/>
                <di:waypoint x="280" y="220"/>
                <di:waypoint x="280" y="138"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNShape id="Wait_1_di" bpmnElement="Wait_1">
                <dc:Bounds x="262" y="102" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="Flow_end_di" bpmnElement="Flow_end">
                <di:waypoint x="298" y="120"/>
                <di:waypoint x="352" y="120"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
                <dc:Bounds x="352" y="102" width="36" height="36"/>
            </bpmndi:BPMNShape>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</bpmn:definitions>
